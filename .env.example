# Copy to .env and fill in. Never commit .env.

# --- Discord ---
DISCORD_TOKEN=

# --- Cloud provider: openai | azure ---
LLM_PROVIDER_CLOUD=openai

# Required when LLM_PROVIDER_CLOUD=openai
OPENAI_API_KEY=

# Required when LLM_PROVIDER_CLOUD=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=

# --- Cloud models (for Azure these are deployment names) ---
CLOUD_CHAT_MODEL=
CLOUD_VISION_MODEL=
CLOUD_STT_MODEL=
CLOUD_TTS_MODEL=
CLOUD_IMAGE_MODEL=

# --- Local models (Ollama, OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_ROUTER_MODEL=qwen3-vl:4b
LOCAL_EMBED_MODEL=bge-m3

# --- Infrastructure ---
DATABASE_URL=postgresql://bot:bot@localhost:5432/bot
SEARXNG_URL=http://localhost:8080

# --- Limits (empty = unlimited) ---
DAILY_CLOUD_TOKEN_BUDGET_PER_USER=

# --- Voice worker ---
VOICE_WORKER_IPC_URL=
